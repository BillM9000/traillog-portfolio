{
  "permissions": {
    "allow": [
      "Bash(gh auth status)",
      "Bash(gh api user --jq '.login')",
      "Bash(cmd.exe /c \"where gh\")",
      "Bash(git config --global user.name)",
      "Bash(git config --global user.email)",
      "Bash(winget install --id GitHub.cli --accept-source-agreements --accept-package-agreements)",
      "Bash(export PATH=\"$PATH:/c/Program Files/GitHub CLI\")",
      "Bash(gh auth login --hostname github.com --git-protocol https --web)",
      "Bash(git init)",
      "Bash(git add -A)"
    ]
  }
}
